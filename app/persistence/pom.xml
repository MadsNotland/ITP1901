<!-- POM for persistence-modulen -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/POM/4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>it1901</groupId>
    <artifactId>workout-tracker-persistence</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging> 

    <!-- Egendefinerte egenskaper som kan gjenbrukes i POM-en -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <!-- Liste over alle eksterne biblioteker som denne modulen trenger -->
    <dependencies>
        <!-- Avhengighet til core-modulen-->
        <dependency>
            <groupId>it1901</groupId>
            <artifactId>workout-tracker-core</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- JUNIT 5 API - grunnleggende test-klasser -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
        <!-- JUNIT 5 ENGINE - kjører testene -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
        <!-- JUNIT 5 PARAMS - parametriserte testklasser -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Build-konfigurasjon -->
    <build>
        <plugins>
            <!-- Maven Compiler Plugin - kompilerer koden -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <!-- Ingen konfigurasjon = standrad kompilering -->
            </plugin>
            <!-- Maven SureFire plugin - kjører enhetstester -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
                <!-- Ingen konfigurasjon = standard test-kjøring -->
            </plugin>
        </plugins>
    </build>
</project>
