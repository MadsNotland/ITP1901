' ===============================================================
' Extensions to download for preview to work:
'   • PlantUML extension (jebbs)
'   • PlantUML Previewer (Mebrahtom Guesh)
'   (Click Ctrl + P to preview) (smaller png is also provided, see folder)
' ===============================================================

@startuml
skinparam packageStyle rectangle
skinparam arrow {
  thickness 1
  color #666666
  style dashed
}

package "workout-tracker" {
' Core module - business logic and REST communication
  package "core" {
    ' Exercise, Workout, WorkoutTracker,
    ' WorkoutService, WorkoutClient, RestWorkoutClient
  }

  ' Persistence module - depends on core
  package "persistence" {
    ' WorkoutFileManager
  }

  ' Server module - depends on core and persistence
  package "server" {
    ' ApiInfoController, ServerApplication, WorkoutController, WorkoutService
  }

  ' UI module - depends on core
  package "ui" {
    ' MainController, ExerciseTableController, WorkoutFormController, 
    ' WorkoutTableController, WorkoutTrackerApp, UiConstants,
    ' base/BaseController.
  }
  persistence --> core
  server --> core
  server --> persistence
  ui --> core

}

@enduml


