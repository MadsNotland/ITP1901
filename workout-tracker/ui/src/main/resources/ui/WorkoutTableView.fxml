<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.WorkoutTableController">

    <!-- Title -->
    <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Workout Sessions" />

    <!-- Table -->
    <TableView fx:id="workoutTable" prefHeight="300" prefWidth="449">
        <columns>
            <TableColumn fx:id="dateColumn" prefWidth="100" text="Date" />
            <TableColumn fx:id="typeColumn" prefWidth="150" text="Type" />
            <TableColumn fx:id="timeColumn" prefWidth="100" text="Time" />
            <TableColumn fx:id="notesColumn" prefWidth="250" text="Notes" />
        </columns>
    </TableView>

    <!-- Button for adding workout session -->
    <Button fx:id="add_workout" id="add_workout" onAction="#handleAddButton" style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-weight: bold;" text="Add Workout" />

    <!-- Save Button -->
    <Button onAction="#handleSave" style="-fx-background-color: #2ECC71; -fx-text-fill: white;" text="Save" />

</VBox>
