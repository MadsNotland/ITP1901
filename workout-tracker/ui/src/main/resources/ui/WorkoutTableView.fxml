<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox 
    alignment="CENTER" 
    spacing="10" 
    styleClass="form-container"
    xmlns="http://javafx.com/javafx/17.0.1" 
    xmlns:fx="http://javafx.com/fxml/1" 
    fx:controller="ui.WorkoutTableController">

    <!-- Title -->
    <Label text="Workout Sessions" styleClass="label-title" />

    <!-- Table -->
    <TableView fx:id="workoutTable" styleClass="exercise-table" prefHeight="300" prefWidth="449" onMouseClicked="#handleRowClick">
        <columns>
            <TableColumn fx:id="dateColumn" prefWidth="100" text="Date" />
            <TableColumn fx:id="typeColumn" prefWidth="150" text="Type" />
            <TableColumn fx:id="timeColumn" prefWidth="100" text="Time" />
            <TableColumn fx:id="notesColumn" prefWidth="255" text="Notes" />
        </columns>
    </TableView>

    <!-- Button for adding workout session -->
    <Button  text="Add Workout" styleClass="button-primary" fx:id="add_workout" id="add_workout" onAction="#handleAddButton" />

</VBox>
