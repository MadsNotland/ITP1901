<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17.0.1"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.WorkoutTableController"
      alignment="CENTER" spacing="10" style="-fx-padding: 20;">

    <!-- Tittel -->
    <Label text="Workout Sessions"
           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>

    <!-- Tabell -->
    <TableView fx:id="workoutTable" prefHeight="300" prefWidth="449">
        <columns>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="100"/>
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="150"/>
            <TableColumn fx:id="timeColumn" text="Time" prefWidth="100"/>
            <TableColumn fx:id="notesColumn" text="Notes" prefWidth="250"/>
        </columns>
    </TableView>

    <!-- Knapp for å legge til ny økt -->
    <Button text="Add Workout"
            style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-weight: bold;"/>

    <!-- (Valgfritt) Lagre-knapp -->
    <Button text="Save"
            onAction="#handleSave"
            style="-fx-background-color: #2ECC71; -fx-text-fill: white;"/>

</VBox>
