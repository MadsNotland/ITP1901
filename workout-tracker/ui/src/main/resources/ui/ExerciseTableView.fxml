<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.ExerciseTableController">
   <Button mnemonicParsing="false" onAction="#handleBack" text="Back" />

    <!-- Title -->
    <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Exercises" />

    <!-- Table -->
    <TableView fx:id="exerciseTable" prefHeight="300" prefWidth="520">
        <columns>
            <!-- Set # is computed in controller via cell factory -->
            <TableColumn fx:id="setColumn" prefWidth="70" text="Set #" />
            <TableColumn fx:id="nameColumn" prefWidth="180" text="Name" />
            <TableColumn fx:id="repsColumn" prefWidth="100" text="Reps" />
            <TableColumn fx:id="weightColumn" prefWidth="120" text="Weight" />
        </columns>
    </TableView>
</VBox>
