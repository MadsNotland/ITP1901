<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?> 
<?import javafx.scene.layout.GridPane?>

<VBox alignment="CENTER" spacing="10" style="-fx-padding: 20;" 
    xmlns="http://javafx.com/javafx/17.0.1" 
    xmlns:fx="http://javafx.com/fxml/1" 
    fx:controller="ui.ExerciseTableController">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button text="Back" onAction="#handleBack"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addButton" text="Add Set" onAction="#handleAdd"/>
        <Button fx:id="deleteButton" text="Delete Selected" onAction="#handleDelete"/>
        <Button fx:id="saveButton" text="Save" onAction="#handleSave"/>
    </HBox>
   
    <!-- Workout Details -->
    <GridPane hgap="10" vgap="8">
        <columnConstraints/>
        <rowConstraints/>

        <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="typeField" editable="false" promptText="Workout name"
                   GridPane.rowIndex="0" GridPane.columnIndex="1" />

        <Label text="Date:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <DatePicker fx:id="datePicker" editable="false"
                    GridPane.rowIndex="1" GridPane.columnIndex="1" />

        <Label text="Time:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <HBox spacing="5" GridPane.rowIndex="2" GridPane.columnIndex="1">
            <ComboBox fx:id="comboBoxHours" prefWidth="80" />
            <Label text="hours" />
            <ComboBox fx:id="comboBoxMinutes" prefWidth="80" />
            <Label text="minutes" />
        </HBox>

        <Label text="Notes:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
        <TextArea fx:id="notesArea" editable="false" prefRowCount="3"
                  GridPane.rowIndex="3" GridPane.columnIndex="1" />
    </GridPane>


    <!-- Title -->
    <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" 
        text="Exercises" />

    <!-- Table -->
    <TableView fx:id="exerciseTable" prefHeight="300" prefWidth="520">
        <columns>
            <!-- Set # is computed in controller via cell factory -->
            <TableColumn fx:id="setColumn" prefWidth="70" text="Set #" />
            <TableColumn fx:id="nameColumn" prefWidth="221.0" text="Name" />
            <TableColumn fx:id="repsColumn" prefWidth="87.0" text="Reps" />
            <TableColumn fx:id="weightColumn" prefWidth="139.0" text="Weight" />
        </columns>
    </TableView>
</VBox>
