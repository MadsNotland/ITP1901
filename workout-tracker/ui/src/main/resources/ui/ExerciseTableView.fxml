<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?> 
<?import javafx.scene.layout.StackPane?> 
<?import javafx.scene.layout.GridPane?>

<VBox alignment="CENTER" spacing="10" styleClass="dark-container" 
    xmlns="http://javafx.com/javafx/17.0.1" 
    xmlns:fx="http://javafx.com/fxml/1" 
    fx:controller="ui.ExerciseTableController">

    <HBox alignment="CENTER_LEFT" spacing="10" maxWidth="700">
        <Button text="Back" onAction="#handleBack" styleClass="button-danger" />
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addButton" text="Add Set" onAction="#handleAdd" styleClass="button-success" />
        <Button fx:id="deleteButton" text="Delete Selected" onAction="#handleDelete" styleClass="button-danger" />
        <Button fx:id="saveButton" text="Save" onAction="#handleSave" styleClass="button-primary"/>
    </HBox>
   
    <!-- Workout Details -->
    <GridPane hgap="10" vgap="8" maxWidth="700">
        <columnConstraints />
        <rowConstraints />

        <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label-field" />
        <TextField fx:id="typeField" editable="false" promptText="Workout name"
                   GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="text-field" />

        <Label text="Date:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="label-field" />
        <DatePicker fx:id="datePicker" editable="false"
                    GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="date-picker" />

        <Label text="Time:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="label-field" />
        <HBox spacing="5" GridPane.rowIndex="2" GridPane.columnIndex="1">
            <ComboBox fx:id="comboBoxHours" prefWidth="80" styleClass="combo-box" />
            <Label text="hours" styleClass="label-description" />
            <ComboBox fx:id="comboBoxMinutes" prefWidth="80" styleClass="combo-box" />
            <Label text="minutes" styleClass="label-description" />
        </HBox>

        <Label text="Notes:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="label-field" />
        <TextArea fx:id="notesArea" promptText="Notes..." editable="false" prefRowCount="3"
                  GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="text-field" />
    </GridPane>


    <!-- Title -->
    <Label text="Exercises" styleClass="label-undertitle" />

    <!-- Table -->
    <HBox alignment="CENTER" maxWidth="800">
        <TableView fx:id="exerciseTable" prefHeight="300" prefWidth="520" styleClass="exercise-table" >
            <columns>
                <!-- Set # is computed in controller via cell factory -->
                <TableColumn fx:id="setColumn" prefWidth="70" text="Set #" />
                <TableColumn fx:id="nameColumn" prefWidth="221.0" text="Name" />
                <TableColumn fx:id="repsColumn" prefWidth="87.0" text="Reps" />
                <TableColumn fx:id="weightColumn" prefWidth="139.0" text="Weight" />
            </columns>
        </TableView>
    </HBox>

    <StackPane maxWidth="700">
        <Button fx:id="infoButton" onAction="#handleInfo" styleClass="button-info" StackPane.alignment="CENTER_RIGHT" translateX="-20" >
            <graphic>
                <ImageView fitHeight="40" fitWidth="40">
                    <image>
                        <Image url="@images/info.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </StackPane>
</VBox>
