<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/POM/4.0.0.xsd">
    <!-- Module POM for the UI. Inherits versions from the parent POM and
         declares module-scoped dependencies and plugins. -->
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>it1901</groupId>
        <artifactId>workout-tracker</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>workout-tracker-ui</artifactId>
    <packaging>jar</packaging>

    <!-- Module-specific dependencies -->
    <dependencies>
        <!-- Dependencies on sibling modules -->
        <dependency>
            <groupId>it1901</groupId>
            <artifactId>workout-tracker-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        

        <!-- JavaFX dependencies -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
        </dependency>

        <!-- TestFX for UI testing -->
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-junit5</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
        </dependency>
        <!-- Headless Glass toolkit for CI: Monocle (match JavaFX version via parent) -->
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>openjfx-monocle</artifactId>
            <version>8u76-b04</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Module-specific build configuration -->
    <build>
        <plugins>
            <!-- Maven Surefire plugin - runs unit tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>
                        ${argLine}
                        --add-opens workout.tracker.core/core=ALL-UNNAMED
                        --add-opens workout.tracker.ui/ui=ALL-UNNAMED
                        --add-exports javafx.graphics/com.sun.javafx.application=ALL-UNNAMED
                        --add-opens=javafx.graphics/com.sun.javafx.application=ALL-UNNAMED
                        --add-exports=javafx.graphics/com.sun.javafx.stage=ALL-UNNAMED
                        --add-opens=javafx.graphics/com.sun.javafx.stage=ALL-UNNAMED
                    </argLine>
                    <systemPropertyVariables>
                        <javafx.platform>Monocle</javafx.platform>
                        <prism.order>sw</prism.order>
                        <headless>true</headless>
                    </systemPropertyVariables>
                    <excludes>
                        <exclude>**/ui/WorkoutTrackerAppTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- JavaFX Maven plugin - run/pack the JavaFX application -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration>
                    <mainClass>workout.tracker.ui/ui.WorkoutTrackerApp</mainClass>
                    <options>
                        <option>--add-exports</option>
                        <option>javafx.base/javafx.collections=ALL-UNNAMED</option>
                    </options>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
