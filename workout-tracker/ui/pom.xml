<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/POM/4.0.0.xsd">
    <!-- Module POM for the UI. Inherits versions from the parent POM and
         declares module-scoped dependencies and plugins. -->
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>it1901</groupId>
        <artifactId>workout-tracker</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>workout-tracker-ui</artifactId>
    <packaging>jar</packaging>

    <!-- Module-specific dependencies -->
    <dependencies>
        <!-- Dependencies on sibling modules -->
        <dependency>
            <groupId>it1901</groupId>
            <artifactId>workout-tracker-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        

        <!-- JavaFX dependencies -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
        </dependency>

        <!-- TestFX for UI testing -->
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-junit5</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
        </dependency>
        <!-- Headless Glass toolkit for CI: Monocle (match JavaFX version via parent) -->
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>openjfx-monocle</artifactId>
            <version>8u76-b04</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Module-specific build configuration -->
    <build>
        <plugins>
            <!-- Maven Surefire plugin - runs unit tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>
                        ${argLine}
                        --add-opens workout.tracker.core/core=ALL-UNNAMED
                        --add-opens workout.tracker.ui/ui=ALL-UNNAMED
                        --add-exports javafx.graphics/com.sun.javafx.application=ALL-UNNAMED
                        --add-opens=javafx.graphics/com.sun.javafx.application=ALL-UNNAMED
                        --add-exports=javafx.graphics/com.sun.javafx.stage=ALL-UNNAMED
                        --add-opens=javafx.graphics/com.sun.javafx.stage=ALL-UNNAMED
                    </argLine>
                    <systemPropertyVariables>
                        <javafx.platform>Monocle</javafx.platform>
                        <prism.order>sw</prism.order>
                        <headless>true</headless>
                    </systemPropertyVariables>
                    <excludes>
                        <exclude>**/ui/WorkoutTrackerAppTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Spotbugs -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
            </plugin>

            <!-- JavaFX Maven plugin - run/pack the JavaFX application (and Jlink) 
                 JLink and packaging setup inspired by the IT1901 Todo List Example:
                 https://gitlab.stud.idi.ntnu.no/it1901/todo-list-example
            -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration>
                    <mainClass>workout.tracker.ui/ui.WorkoutTrackerApp</mainClass>

                    <!-- These 4 controls the jlink-part -->
                    <compress>2</compress>
                    <stripDebug>true</stripDebug>
                    <noHeaderFiles>true</noHeaderFiles>
                    <noManPages>true</noManPages>

                    <!-- Name on runtime image and runnable launcher -->
                    <launcher>workout-tracker</launcher>
                    <jlinkImageName>workout-tracker-${os.target}</jlinkImageName>
                    <jlinkZipName>workout-tracker-${os.target}</jlinkZipName>
                </configuration>
            </plugin>

            <!-- Jpackage plugin - creates platform installers from the jlink runtime image -->
            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.4.0</version>
                <configuration>
                    <!-- Basic metadata -->
                    <name>WorkoutTracker</name>
                    <appVersion>1.0.0</appVersion>
                    <vendor>NTNU</vendor>
                    <!-- Where to place the installer -->
                    <destination>target/dist-${os.target}</destination>
                    <!-- Use the runtime image built by jlink -->
                    <runtimeImage>target/workout-tracker-${os.target}</runtimeImage>
                    <module>workout.tracker.ui/ui.WorkoutTrackerApp</module>
                    <!-- Optional launcher and icon -->
                    <javaOptions>
                        <option>-Dfile.encoding=UTF-8</option>
                    </javaOptions>
                    <!-- Platform-specific options -->
                    <winShortcut>true</winShortcut>
                    <winMenu>true</winMenu>
                    <winDirChooser>true</winDirChooser>

                    <linuxShortcut>false</linuxShortcut>
                    <linuxMenuGroup></linuxMenuGroup>

                    <macPackageIdentifier>no.ntnu.workouttracker</macPackageIdentifier>
                    <macPackageName>WorkoutTracker</macPackageName>
                </configuration>

            </plugin>
        </plugins>
    </build>
    
    <!-- OS-specific build profiles.
         These profiles allow building JavaFX runtime images for different platforms (Linux, macOS, Windows)
         by setting the appropriate properties used by the javafx-maven-plugin.
    -->
    <profiles>
        <!-- Linux -->
        <profile>
            <id>linux</id>
            <activation>
            <os>
                <family>unix</family>
            </os>
            </activation>
            <properties>
            <os.target>linux</os.target>
            <javafx.platform>linux</javafx.platform>
            </properties>
        </profile>
        <!-- Windows -->
        <profile>
            <id>win</id>
            <activation>
            <os>
                <family>windows</family>
            </os>
            </activation>
            <properties>
            <os.target>win</os.target>
            <javafx.platform>win</javafx.platform>
            </properties>
        </profile>
        <!-- macOS -->
        <profile>
            <id>mac</id>
            <activation>
            <os>
                <family>mac</family>
            </os>
            </activation>
            <properties>
            <os.target>mac</os.target>
            <javafx.platform>mac</javafx.platform>
            </properties>
        </profile>
    </profiles>

</project>
