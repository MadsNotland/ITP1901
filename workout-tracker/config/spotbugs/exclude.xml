<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Suppress warnings in generated code -->
  <Match>
    <Class name="~.*\.generated\..*"/>
  </Match>

  <!-- Allow constructor validation in core.Workout - legitimate design choice -->
  <Match>
    <Class name="core.Workout"/>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>

  <!-- Expose live ObservableList for UI bindings by design -->
  <Match>
    <Class name="core.WorkoutTracker"/>
    <Method name="getAllWorkouts"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
</FindBugsFilter>
