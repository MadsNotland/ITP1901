<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Suppress warnings in generated code -->
  <Match>
    <Class name="~.*\.generated\..*"/>
  </Match>

  <!-- Allow constructor validation in core.Workout - legitimate design choice -->
  <Match>
    <Class name="core.Workout"/>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>

  <!-- Expose live ObservableList for UI bindings by design -->
  <Match>
    <Class name="core.WorkoutTracker"/>
    <Method name="getAllWorkouts"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>

  <!-- Ignore Internal representation warning in controllers-->
  <!-- Controllers intentionally share mutable references for coordination between views -->
  <Match>
    <Class name="ui.MainController"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>

  <Match>
    <Class name="ui.WorkoutFormController"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

  <Match>
    <Class name="ui.WorkoutTableController"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

  <Match>
    <Class name="ui.WorkoutTableController"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

  <Match>
    <Class name="ui.service.WorkoutService"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>

  <Match>
    <Class name="ui.service.WorkoutService"/>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>

  <!-- Ignore Internal representation warning in Spring Boot controllers -->
  <Match>
    <Class name="server.WorkoutController"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  
</FindBugsFilter>
