<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Example: suppress warnings in generated code -->
  <Match>
    <Class name="~.*\.generated\..*"/>
  </Match>

  <!-- Example: allow nulls in DTOs (tweak to your packages) -->
  <Match>
    <Package name="com.example.dto"/>
    <Bug pattern="NP_NULL_PARAM_DEREF,NP_NULL_ON_SOME_PATH"/>
  </Match>

  <!-- Allow constructor validation in core.Workout -->
  <Match>
    <Class name="core.Workout"/>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>

  <!-- Expose live ObservableList for UI bindings by design -->
  <Match>
    <Class name="core.WorkoutTracker"/>
    <Method name="getAllWorkouts"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>

  <!-- Ignore Internal representation warning in controllers-->
  <!-- Controllers intentionally share mutable references for coordination between views -->
  <Match>
    <Class name="ui.MainController"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>

  <Match>
    <Class name="ui.WorkoutFormController"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

  <Match>
    <Class name="ui.WorkoutTableController"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

  <Match>
    <Class name="ui.WorkoutTableController"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  
</FindBugsFilter>
