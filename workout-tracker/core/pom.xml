<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/POM/4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Inherits from parent -->
    <parent>
        <groupId>it1901</groupId>
        <artifactId>workout-tracker</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>workout-tracker-core</artifactId>
    <packaging>jar</packaging>

    <!-- Module-specific dependencies -->
    <dependencies>
        <!-- JavaFX dependency for ObservableList -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
        </dependency>
        <!-- JUNIT 5 API - basic test classes -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>
        <!-- JUNIT 5 ENGINE - runs the tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
        </dependency>
        <!-- Jackson for JSON serialization/deserialization in REST client -->
        <!-- Jackson-annotations provides annotations for JSON mapping -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.15.2</version>
        </dependency>
        <!-- Jackson-core provides the foundational JSON parsing capabilities -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>2.15.2</version>
        </dependency>
        <!-- Jackson-databind enables conversion between JSON and Java objects -->
        <!-- Used to serialize Workout objects to JSON for POST/PUT requests -->
        <!-- and deserialize JSON responses to Workout objects from GET requests -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.15.2</version>
        </dependency>
        <!-- Jackson-datatype-jsr310 provides support for Java 8+ time types -->
        <!-- Required for proper serialization/deserialization of LocalDate fields -->
        <!-- in Workout objects (e.g., workout.getDate() returns LocalDate) -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>2.15.2</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
